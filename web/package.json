{
  "name": "tg-download-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram 下载器（基于 tdl）飞牛 fpk 前端",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,json}\"",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "vant": "^4.10.2",
